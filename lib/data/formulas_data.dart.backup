      latex: r'Q = I^2Rt',
      description: 'Количество теплоты, выделяющееся в проводнике',
      category: FormulaCategory.physics,
      examples: [
        FormulaExample(
          problem: 'Найти количество теплоты при I = 5 А, R = 4 Ом, t = 10 с',
          given: 'I = 5 А, R = 4 Ом, t = 10 с',
          solution: 'Q = 5² · 4 · 10 = 25 · 40 = 1000 Дж = 1 кДж',
          answer: 'Q = 1 кДж',
        ),
        FormulaExample(
          problem: 'За какое время выделится 7200 Дж при I = 6 А и R = 10 Ом?',
          given: 'Q = 7200 Дж, I = 6 А, R = 10 Ом',
          solution: 't = Q / (I²R) = 7200 / (36 · 10) = 20 с',
          answer: 't = 20 с',
        ),
        FormulaExample(
          problem: 'Найти сопротивление нагревателя, если за 5 минут при токе 4 А выделяется 240 кДж',
          given: 'Q = 240 кДж = 240000 Дж, I = 4 А, t = 300 с',
          solution: 'R = Q / (I²t) = 240000 / (16 · 300) = 50 Ом',
          answer: 'R = 50 Ом',
        ),
      ],
    ),
    
    // Уравнение состояния идеального газа
    Formula(
      id: 'p17',
      title: 'Уравнение состояния идеального газа',
      latex: r'PV = nRT',
      description: 'Уравнение Менделеева-Клапейрона, где R = 8.31 Дж/(моль·К)',
      category: FormulaCategory.physics,
      examples: [
        FormulaExample(
          problem: 'Во сколько раз увеличится давление, если температуру увеличить в 2 раза при постоянном объёме?',
          given: 'T₂ = 2T₁, V = const',
          solution: 'P₁/T₁ = P₂/T₂\nP₂ = P₁ · (T₂/T₁) = 2P₁',
          answer: 'В 2 раза',
        ),
        FormulaExample(
          problem: 'Газ расширяется от 2 л до 6 л при постоянной температуре и начальном давлении 300 кПа. Найти конечное давление',
          given: 'V₁ = 2 л, V₂ = 6 л, P₁ = 300 кПа, T = const',
          solution: 'P₁V₁ = P₂V₂\nP₂ = P₁ · V₁/V₂ = 300 · 2/6 = 100 кПа',
          answer: 'P₂ = 100 кПа',
        ),
        FormulaExample(
          problem: 'Найти температуру, если 1 моль газа занимает 20 л при давлении 100 кПа',
          given: 'n = 1 моль, V = 20 л = 0.02 м³, P = 100 кПа = 100000 Па',
          solution: 'T = PV/(nR) = 100000 · 0.02 / (1 · 8.31)\n≈ 241 К',
          answer: 'T ≈ 241 К',
        ),
      ],
    ),
    
    // КПД тепловой машины
    Formula(
      id: 'p18',
      title: 'КПД тепловой машины',
      latex: r'\eta = \frac{A}{Q_1} = \frac{Q_1 - Q_2}{Q_1}',
      description: 'Коэффициент полезного действия тепловой машины',
      category: FormulaCategory.physics,
      examples: [
        FormulaExample(
          problem: 'Найти КПД, если получено 1000 Дж тепла, а совершена работа 300 Дж',
          given: 'Q₁ = 1000 Дж, A = 300 Дж',
          solution: 'η = (300 / 1000) · 100% = 30%',
          answer: 'η = 30%',
        ),
        FormulaExample(
          problem: 'Найти полезную работу, если Q₁ = 5000 Дж и η = 25%',
          given: 'Q₁ = 5000 Дж, η = 25% = 0.25',
          solution: 'A = Q₁ · η = 5000 · 0.25 = 1250 Дж',
          answer: 'A = 1250 Дж',
        ),
        FormulaExample(
          problem: 'Найти Q₂, если Q₁ = 2000 Дж и η = 40%',
          given: 'Q₁ = 2000 Дж, η = 40% = 0.4',
          solution: 'A = 2000 · 0.4 = 800 Дж\nQ₂ = Q₁ - A = 2000 - 800 = 1200 Дж',
          answer: 'Q₂ = 1200 Дж',
        ),
      ],
    ),
    
    // Энергия фотона
    Formula(
      id: 'p19',
      title: 'Энергия фотона',
      latex: r'E = h\nu = \frac{hc}{\lambda}',
      description: 'Энергия фотона, где h = 6.63·10⁻³⁴ Дж·с - постоянная Планка',
      category: FormulaCategory.physics,
      examples: [
        FormulaExample(
          problem: 'Найти энергию фотона с частотой 5·10¹⁴ Гц',
          given: 'ν = 5·10¹⁴ Гц, h = 6.63·10⁻³⁴ Дж·с',
          solution: 'E = 6.63·10⁻³⁴ · 5·10¹⁴\n= 3.315·10⁻¹⁹ Дж',
          answer: 'E ≈ 3.32·10⁻¹⁹ Дж',
        ),
        FormulaExample(
          problem: 'Найти длину волны фотона с энергией 4·10⁻¹⁹ Дж',
          given: 'E = 4·10⁻¹⁹ Дж, c = 3·10⁸ м/с, h = 6.63·10⁻³⁴ Дж·с',
          solution: 'λ = hc/E = (6.63·10⁻³⁴ · 3·10⁸)/(4·10⁻¹⁹)\n≈ 4.97·10⁻⁷ м = 497 нм',
          answer: 'λ ≈ 497 нм',
        ),
        FormulaExample(
          problem: 'Найти частоту фотона с длиной волны 600 нм',
          given: 'λ = 600 нм = 6·10⁻⁷ м, c = 3·10⁸ м/с',
          solution: 'ν = c/λ = 3·10⁸ / 6·10⁻⁷ = 5·10¹⁴ Гц',
          answer: 'ν = 5·10¹⁴ Гц',
        ),
      ],
    ),
    
    // Уравнение Эйнштейна для фотоэффекта
    Formula(
      id: 'p20',
      title: 'Уравнение Эйнштейна для фотоэффекта',
      latex: r'h\nu = A + E_k',
      description: 'Уравнение фотоэффекта, где A - работа выхода',
      category: FormulaCategory.physics,
      examples: [
        FormulaExample(
          problem: 'Найти кинетическую энергию электрона, если ν = 10¹⁵ Гц и A = 3·10⁻¹⁹ Дж',
          given: 'ν = 10¹⁵ Гц, A = 3·10⁻¹⁹ Дж, h = 6.63·10⁻³⁴ Дж·с',
          solution: 'Eₖ = hν - A = 6.63·10⁻³⁴ · 10¹⁵ - 3·10⁻¹⁹\n≈ 3.63·10⁻¹⁹ Дж',
          answer: 'Eₖ ≈ 3.63·10⁻¹⁹ Дж',
        ),
        FormulaExample(
          problem: 'Найти красную границу фотоэффекта для A = 2·10⁻¹⁹ Дж',
          given: 'A = 2·10⁻¹⁹ Дж, h = 6.63·10⁻³⁴ Дж·с, c = 3·10⁸ м/с',
          solution: 'ν_min = A/h = 2·10⁻¹⁹ / 6.63·10⁻³⁴ ≈ 3·10¹⁴ Гц\nλ_max = c/ν_min ≈ 1000 нм',
          answer: 'λ_max ≈ 1000 нм',
        ),
        FormulaExample(
          problem: 'Найти работу выхода, если при λ = 300 нм Eₖ = 2·10⁻¹⁹ Дж',
          given: 'λ = 300 нм = 3·10⁻⁷ м, Eₖ = 2·10⁻¹⁹ Дж',
          solution: 'E_фотона = hc/λ ≈ 6.63·10⁻¹⁹ Дж\nA = E_фотона - Eₖ ≈ 4.63·10⁻¹⁹ Дж',
          answer: 'A ≈ 4.63·10⁻¹⁹ Дж',
        ),
      ],
    ),
  ];
}
